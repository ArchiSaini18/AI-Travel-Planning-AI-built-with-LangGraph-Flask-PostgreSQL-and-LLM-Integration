# ============================================
# Travel Planner AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to GitHub (it's in .gitignore)

# ============================================
# 1. DATABASE CONFIGURATION
# ============================================

# For Local Development (SQLite):
# DATABASE_URL=sqlite:///travel_planner.db

# For Render.com Production (PostgreSQL):
# Step 1: Create PostgreSQL database on Render
# Step 2: Copy "External Database URL" from Render Dashboard
# Step 3: Paste it below
DATABASE_URL=postgresql://user:password@db.render.com:5432/travel_planner_db

# ============================================
# 2. OPENROUTER API (LLM - Llama 3.3 70B)
# ============================================

# How to get API key:
# 1. Go to https://openrouter.ai
# 2. Sign up (or login)
# 3. Navigate to "Keys" section
# 4. Create new API key
# 5. Copy and paste below (starts with "sk-or-")
OPENROUTER_API_KEY=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

# Which model to use (Don't change this)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter endpoint (Don't change this)
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# ============================================
# 3. SESSION MANAGEMENT (Flask Secret Key)
# ============================================

# For security, use a random string
# You can generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=travel-planner-secret-key-2025-production

# ============================================
# AUTO-CONFIGURED (No setup needed)
# ============================================

# These APIs are free and don't need authentication:
# - Weather API: Open-Meteo (https://api.open-meteo.com)
# - Currency API: Frankfurter (https://api.frankfurter.app)
# The app handles them automatically

# ============================================
# QUICK RENDER SETUP CHECKLIST
# ============================================

# ✅ Step 1: Create PostgreSQL database
#    - Render Dashboard → "+ New" → "Postgres"
#    - Wait 2-3 minutes for database creation
#    - Copy "External Database URL"

# ✅ Step 2: Create Web Service
#    - Render Dashboard → "+ New" → "Web Service"
#    - Connect GitHub repository (travel-planner-ai)
#    - Build Command: pip install -r requirements.txt
#    - Start Command: python main.py

# ✅ Step 3: Add Environment Variables in Render
#    - Go to Service Settings → Environment
#    - Add each variable from this file:
#      * DATABASE_URL (from Postgres)
#      * OPENROUTER_API_KEY
#      * OPENROUTER_MODEL
#      * OPENROUTER_URL
#      * SESSION_SECRET

# ✅ Step 4: Deploy
#    - Render auto-deploys after variables are set
#    - Check logs for "Running on http://0.0.0.0:5000"
#    - Get live URL from dashboard

# ============================================
# TROUBLESHOOTING
# ============================================

# ERROR: Database connection refused
#   FIX: Check DATABASE_URL is correct from Render Postgres page

# ERROR: API key invalid
#   FIX: Visit https://openrouter.ai/keys and get new key

# ERROR: Build failed
#   FIX: Check Render logs, verify requirements.txt is updated

# ERROR: Deployment stuck
#   FIX: Click "Cancel Deployment" and redeploy

# See  file for complete step-by-step guide!
